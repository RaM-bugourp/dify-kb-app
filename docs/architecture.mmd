graph TB
    subgraph CLIENT["前端 · React 18 + Vite 5 + TS"]
        UI["桌面两栏界面<br/>左：知识库/分区树<br/>右：表格 · 图片 · 文档"]
    end

    subgraph SERVER["后端 · Node/Express :3001（单端口）"]
        ROUTES["REST API 路由层<br/>/api/datasets · /api/tables · /api/images · /api/dify"]
        BRIDGE["Dify 桥接层<br/>dify-bridge.js<br/>（分区到 Dify 知识库映射）"]
        STORE["数据访问层 store.js<br/>函数签名稳定 · 可切换实现"]
    end

    subgraph DATA["本地存储（当前）"]
        JSON["server/data.json<br/>知识库 · 分区 · 表格 · 文档元数据 · difyMappings"]
        MEDIA["server/media/<br/>图片原图 (jpg/png)"]
    end

    subgraph FUTURE["预留扩展"]
        MYSQL["MySQL<br/>结构化数据精确查询"]
        VECTOR["向量库<br/>Qdrant / pgvector"]
    end

    subgraph EXTERNAL["外部 · Dify RAG（仅向量化）"]
        DIFY["Dify Dataset<br/>文档分段 到 Embedding 到 向量检索"]
    end

    UI -->|"fetch JSON"| ROUTES
    ROUTES --> STORE
    ROUTES --> BRIDGE
    BRIDGE -->|"映射查询/写映射"| STORE
    BRIDGE -->|"文档入库 / 检索 (USE_REAL_DIFY=true)"| DIFY

    STORE --> JSON
    STORE --> MEDIA

    STORE -.->|"未来切换（签名不变）"| MYSQL
    BRIDGE -.->|"未来切换（签名不变）"| VECTOR

    classDef external fill:#2a1f3d,stroke:#8b5cf6,color:#e9d5ff;
    classDef future fill:#1f2a1f,stroke:#3fb950,color:#a5d6a7;
    classDef core fill:#16203a,stroke:#58a6ff,color:#cfe3ff;
    class DIFY external;
    class MYSQL,VECTOR future;
    class UI,ROUTES,BRIDGE,STORE,JSON,MEDIA core;
