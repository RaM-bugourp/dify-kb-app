{
  "name": "dify-kb-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev\"",
    "gen:media": "node scripts/gen-media.mjs",
    "package": "node scripts/package.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "mammoth": "^1.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
